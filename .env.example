SECRET_KEY=changeme
DEBUG=0
DJANGO_ALLOWED_HOSTS=your.domain.com
CSRF_TRUSTED_ORIGINS=https://your.domain.com

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret

SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=postgres
SQL_USER=postgres
SQL_PASSWORD=secret
SQL_HOST=db
SQL_PORT=5432

CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672/
CELERY_RESULT_BACKEND=rpc://

STATIC_ROOT=/static/

# WEATHER_SENSORS=temp,humid,press,windspeed,winddir,rain,skytemp,sunalt
# WEATHER_PLOTS=temp,humid,press,windspeed,winddir,rain,skytemp

OBSERVER_NAME=My Observatory
OBSERVER_LONGITUDE=0.0
OBSERVER_LATITUDE=0.0
OBSERVER_ELEVATION=0.0
# WINDOW_TITLE=Weather at My Observatory

USE_INFLUX=1
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=your-token-here
INFLUXDB_ORG=your-org
INFLUXDB_BUCKET=weather
INFLUXDB_BUCKET_5MIN=weather_average
INFLUXDB_MEASUREMENT_AVERAGE=average

# Keycloak login (pyobs-auth) - leave KEYCLOAK_SERVER_URL unset/empty to disable Keycloak login
# entirely (the frontend then hides the login link too).
# KEYCLOAK_SERVER_URL=https://keycloak.example.org
# KEYCLOAK_REALM=pyobs
# KEYCLOAK_CLIENT_ID=weather
# KEYCLOAK_CLIENT_SECRET=your-client-secret
# KEYCLOAK_REDIRECT_URI=https://your.domain.com/accounts/keycloak/callback/
# KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://your.domain.com/
# KEYCLOAK_IDP_HINT=
# KEYCLOAK_IDP_LABEL=
# Keycloak group required to log in - per-installation, not fleet-wide. Set empty to disable
# the authorization gate (every authenticated Keycloak user would be authorized).
# KEYCLOAK_REQUIRED_GROUP=/pyobs-weather
